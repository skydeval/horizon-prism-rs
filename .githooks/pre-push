#!/bin/sh
# Refuse a push if any tracked file, or the message of any commit being
# pushed, holds a blocked word (tools/name-guard.py).
guard="$(git rev-parse --show-toplevel)/tools/name-guard.py"
python3 -I "$guard" --all || exit 1
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        python3 -I "$guard" --range "$local_sha" --not --remotes || exit 1
    else
        python3 -I "$guard" --range "$remote_sha..$local_sha" || exit 1
    fi
done
exit 0
