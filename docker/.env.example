# horizon-prism-rs environment (design v1 §11.3).
# Copy to docker/.env and fill in. docker/.env is gitignored; never commit it.
# Compose refuses to start if a required value is missing.

# Public DNS name for this AppView. Must resolve (A/AAAA) to this host before
# first start so Caddy can obtain a certificate. The AppView's DID is
# did:web:<this value>.
APP_PUBLIC_HOSTNAME=appview.example.com

# Contact address for the ACME (Let's Encrypt) account Caddy registers.
CADDY_ACME_EMAIL=ops@example.com

# Postgres role and database created on first start of the db service.
POSTGRES_USER=prism
POSTGRES_DB=prism

# Postgres password. Hex characters only: it is embedded in APP_DATABASE_URL.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-chars

# Redis memory ceiling (redis maxmemory syntax). Redis runs with noeviction, so
# writes fail rather than evict once this is reached. Redis holds only the
# firehose stream (1500000 entries, ~1.5-3 GiB), dead letters, cursor keys and a
# capped refresh set; request caches are in-process. See docker/README.md "Sizing".
REDIS_MAXMEMORY=6gb

# AppView service signing key: 32-byte secp256k1 secret, hex (64 chars).
# Published as the #atproto key in /.well-known/did.json and used to sign
# outbound service JWTs. Generate with the admin keygen subcommand
# (docker/README.md "Generate keys").
APP_SERVICE_SIGNING_KEY_HEX=replace-with-64-hex-chars

# kryphocron audit correlation key: 32 bytes, hex (64 chars). Printed by the
# same keygen subcommand. Rotating it breaks audit correlation across the change.
APP_CORRELATION_KEY_HEX=replace-with-64-hex-chars

# Migration gate (design §4.3). Keep 0. Set to 1 only while applying pending
# migrations after taking a pg_dump, then set back to 0.
APP_ALLOW_STARTUP_MIGRATE=0

# Log filter for the app (tracing env-filter syntax), e.g. info or info,horizon_prism_rs=debug
APP_LOG_LEVEL=info
