{
  "lexicon": 1,
  "id": "app.nearhorizon.refract.getPostThread",
  "defs": {
    "main": {
      "type": "query",
      "description": "As app.bsky.feed.getPostThread, for an anchor post by an account this AppView serves for a listed community. Parts by other accounts come from the AppViews this AppView reads, as on any thread.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" },
          "depth": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 6 },
          "parentHeight": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 80 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["thread"],
          "properties": {
            "servedAs": { "type": "string", "knownValues": ["member", "visitor"], "description": "The form this answer was served in: `member` (a ready member, with its stored viewer state) or `visitor` (anyone else)." },
            "viewerChecked": { "type": "ref", "ref": "app.nearhorizon.refract.defs#viewerChecked" },
            "thread": { "type": "union", "refs": ["app.bsky.feed.defs#threadViewPost", "app.bsky.feed.defs#notFoundPost", "app.bsky.feed.defs#blockedPost"] }
          }
        }
      },
      "errors": [{ "name": "NotEnabled" }, { "name": "AuthRequired" }, { "name": "InvalidToken" }, { "name": "RateLimitExceeded" }, { "name": "NotFound" }]
    }
  }
}
