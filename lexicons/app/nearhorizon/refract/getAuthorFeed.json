{
  "lexicon": 1,
  "id": "app.nearhorizon.refract.getAuthorFeed",
  "defs": {
    "main": {
      "type": "query",
      "description": "As app.bsky.feed.getAuthorFeed, for an account this AppView serves for a listed community, built from its stored posts and reposts.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" },
          "filter": {
            "type": "string",
            "knownValues": ["posts_with_replies", "posts_no_replies", "posts_with_media", "posts_and_author_threads", "posts_with_video"],
            "default": "posts_with_replies"
          },
          "includePins": { "type": "boolean", "default": false }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "cursor": { "type": "string" },
            "feed": { "type": "array", "items": { "type": "ref", "ref": "app.bsky.feed.defs#feedViewPost" } }
          }
        }
      },
      "errors": [{ "name": "NotEnabled" }, { "name": "AuthRequired" }, { "name": "InvalidToken" }, { "name": "RateLimitExceeded" }, { "name": "NotFound" }, { "name": "AccountTakedown" }, { "name": "AccountDeactivated" }, { "name": "InvalidRequest", "description": "Profile not found: the account is deleted." }]
    }
  }
}
