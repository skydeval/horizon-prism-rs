{
  "lexicon": 1,
  "id": "app.nearhorizon.feed.getAuthorPolls",
  "defs": {
    "main": {
      "type": "query",
      "description": "List an account's public poll posts, newest first. Polls whose visibility is not 'public' are never returned. No tallies and no vote state. Does not require auth.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["polls"],
          "properties": {
            "cursor": { "type": "string" },
            "polls": {
              "type": "array",
              "items": { "type": "ref", "ref": "#pollView" }
            }
          }
        }
      }
    },
    "pollView": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "author": { "type": "ref", "ref": "app.bsky.actor.defs#profileViewBasic" },
        "record": { "type": "unknown", "description": "The app.nearhorizon.poll.post record." },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
